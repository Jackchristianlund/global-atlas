# GLOBAL ATLAS – environment variables (all optional in the MVP).
# The MVP ships a curated, dated snapshot and makes no network calls.
# These keys are read by the planned ingestion service (see docs/ARCHITECTURE.md).

# Base URL of the backend API. Empty = use the bundled snapshot.
VITE_API_BASE_URL=

# ACLED API (registration required): https://acleddata.com/
ACLED_API_KEY=
ACLED_EMAIL=

# UCDP API token: https://ucdp.uu.se/apidocs/
UCDP_API_TOKEN=

# UNHCR Refugee Data Finder needs no key: https://api.unhcr.org/
# IMF PortWatch (chokepoint transits) needs no key: https://portwatch.imf.org/

# PostgreSQL + PostGIS connection for the backend
DATABASE_URL=postgres://atlas:atlas@localhost:5432/atlas

# ── Satellite and hybrid imagery (detailed map) ──────────────────────────────
# Without these the Satellite and Hybrid styles use EOX's Sentinel-2 cloudless
# 2016 mosaic: CC BY 4.0 data, but EOX's hosted tiles are for non-commercial
# use only. Set a commercially licensed provider before any monetisation.
# See docs/IMAGERY.md.
#   maptiler | esri | mapbox | stadia
VITE_SATELLITE_PROVIDER=
VITE_SATELLITE_KEY=
# Optional: a full tile URL template instead of a named provider, and the
# attribution its licence requires.
VITE_SATELLITE_URL=
VITE_SATELLITE_ATTRIBUTION=
